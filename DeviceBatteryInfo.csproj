<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Plugin "Device Battery Info" do OpenWigiDashManager (.NET 10, SDK 3.0). Bateria de mouse, teclado e headset no tile. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OpenWigiDash.DeviceBatteryInfo</RootNamespace>
    <AssemblyName>OpenWigiDash.DeviceBatteryInfo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>Victor Perez</Authors>
    <Product>Device Battery Info</Product>
    <Description>Bateria dos dispositivos do PC no WigiDash (OpenWigiDashManager): mouse, teclado e headset Logitech pelo G HUB e aparelhos Bluetooth pelo Windows, sem trocar de aparelho sozinho e sem ficar preso em "desconectado".</Description>
  </PropertyGroup>

  <!-- `dotnet pack` gera o pacote de plugin para o nuget.org (docs/sdk.md do OpenWigiDashManager,
       "Publicar no nuget.org"). Enquanto o SDK for preview, o plugin também é (NU5104). -->
  <PropertyGroup>
    <OpenWigiDashPlugin>true</OpenWigiDashPlugin>
    <PackageId>OpenWigiDash.DeviceBatteryInfo</PackageId>
    <Title>Device Battery Info</Title>
    <Version>1.1.0-preview.1</Version>
    <PackageTags>battery;logitech;ghub;bluetooth;mouse;keyboard;headset</PackageTags>
    <PackageProjectUrl>https://github.com/OpenWigiDash/OpenWigiDash-DeviceBatteryInfo-Plugin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OpenWigiDash/OpenWigiDash-DeviceBatteryInfo-Plugin</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- O SDK vem do nuget.org. Para testar mudanças no SDK antes de publicar, compile com
       -p:UseLocalOpenWigiSdk=true e o repo OpenWigiDashManager clonado ao lado deste. -->
  <PropertyGroup>
    <OpenWigiSdkVersion>3.0.0-preview.1</OpenWigiSdkVersion>
    <OpenWigiSdkProject Condition="'$(OpenWigiSdkProject)' == ''">$(MSBuildThisFileDirectory)..\OpenWigiDashManager\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj</OpenWigiSdkProject>
  </PropertyGroup>

  <!-- Contrato e UI vêm do host (uma cópia só): o plugin compila contra eles mas não leva junto. -->
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' == 'true'">
    <ProjectReference Include="$(OpenWigiSdkProject)" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' != 'true'">
    <PackageReference Include="OpenWigiDash.Sdk" Version="$(OpenWigiSdkVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <!-- Pelo pacote, o NuGet importa o .targets do SDK sozinho; pela referência de projeto, importamos à mão. -->
  <Import Project="$([System.IO.Path]::GetDirectoryName($(OpenWigiSdkProject)))\build\OpenWigiDash.Sdk.targets"
          Condition="'$(UseLocalOpenWigiSdk)' == 'true'" />

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Logo "G" do G HUB (ícone do lghub.exe), desenhado no selo do tile. -->
    <EmbeddedResource Include="Assets\ghub-logo.png" LogicalName="ghub-logo.png" />
    <!-- Runa do Bluetooth num círculo azul, desenhada para o plugin. -->
    <EmbeddedResource Include="Assets\bluetooth-logo.png" LogicalName="bluetooth-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeviceBatteryInfo.Tests" />
  </ItemGroup>

  <!-- Os testes têm projeto próprio. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
